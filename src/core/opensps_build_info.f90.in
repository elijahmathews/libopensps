!> @brief The source revision a build was made from, generated by Meson (vcs_tag) on every build.
!> @details The identifier is `git describe --tags --dirty --always`, e.g. `v0.2.0-37-g6de9eb6`.
!>   On the commit that carries the release tag it is exactly the tag, and then it is suppressed:
!>   a release reports no build identifier. Builds with no git history (source archives, RPM and
!>   DEB builds) fall back to the tag of their own version, so they report none either.
module opensps_build_info
    use, intrinsic :: iso_c_binding, only: c_char, c_null_char, c_ptr, c_loc
    use opensps_version, only: OPENSPS_VERSION_STRING
    implicit none
    private

    character(len=*), parameter :: RAW_BUILD_ID = '@VCS_TAG@'

    public :: opensps_build_id, opensps_get_build_id

contains

    !> @brief Build identifier, or an empty string for a release build.
    function opensps_build_id() result(id)
        character(len=:), allocatable :: id
        if (RAW_BUILD_ID == 'v'//OPENSPS_VERSION_STRING) then
            id = ''
        else
            id = RAW_BUILD_ID
        end if
    end function opensps_build_id

    !> @brief C API: null-terminated build identifier ("" for a release build); static storage.
    !> @details Every call writes the same bytes, so concurrent calls are harmless.
    function opensps_get_build_id() bind(C, name='opensps_get_build_id') result(p)
        type(c_ptr) :: p
        character(kind=c_char), target, save :: buf(len(RAW_BUILD_ID) + 1)
        character(len=:), allocatable :: id
        integer :: i

        id = opensps_build_id()
        buf = c_null_char
        do i = 1, len(id)
            buf(i) = id(i:i)
        end do
        p = c_loc(buf)
    end function opensps_get_build_id

end module opensps_build_info
