!> @brief The library version, generated by Meson from the project version in meson.build.
module opensps_version
    implicit none
    private

    !> @brief Version string of the library (the same as the C API's opensps_get_version_string)
    character(len=*), parameter, public :: OPENSPS_VERSION_STRING = '@OPENSPS_VERSION_STRING@'
end module opensps_version
