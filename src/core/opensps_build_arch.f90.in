!> @brief The offload target(s) this library was built for, generated by Meson from -Daccel and -Dgpu_arch.
!> @details Empty in a build without GPU offload. Several targets (`cc80,cc90`) mean a build for more than one
!>   architecture: the tuning registry then cannot tell which one it runs on (opensps_tuning, doc/TUNING.md).
module opensps_build_arch
    implicit none
    private

    character(len=*), parameter, public :: BUILD_GPU_ARCH = '@GPU_ARCH@'
end module opensps_build_arch
